{
  "name": "car-performance-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive car performance simulator: live driving, acceleration tests, drag racing, dyno and tuning for a Lexus IS200t and a \u0160koda Superb Combi 280.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "generate:stats": "UPDATE_GENERATED=1 vitest run src/data/catalog/__tests__/stockStats.test.ts",
    "generate:gaps": "UPDATE_GENERATED=1 vitest run src/data/catalog/__tests__/gapsReport.test.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
